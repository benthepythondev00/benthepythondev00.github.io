 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Frankfurter Exchange Rates Scraper",
    "description": "Collect Frankfurter FX records and export currency, rate, base currency, rate date, amount, source as structured JSON, CSV or Excel data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "currency": "AUD",
          "rate": 1.4386,
          "base_currency": "USD",
          "rate_date": "2026-10-07",
          "amount": 1,
          "source": "Frankfurter FX",
          "scraped_at": "2026-10-07T17:50:07.788724+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
