   "store": "benthepythondev",
   "product": "aitoptools-scraper",
   "storePage": "https://api.market/store/benthepythondev/aitoptools-scraper",
   "plans": [
    {
     "name": "Free",
     "type": "SUBSCRIPTION",
     "pricePerMonthUSD": 0,
     "callsPerMonth": 50,
     "pricePerCallUSD": null,
     "requestsPerSecond": 2
    },
    {
     "name": "Basic",
     "type": "SUBSCRIPTION",
     "pricePerMonthUSD": 9.99,
     "callsPerMonth": 1500,
     "pricePerCallUSD": null,
     "requestsPerSecond": 2
    },
    {
     "name": "Pro",
     "type": "SUBSCRIPTION",
     "pricePerMonthUSD": 29.99,
     "callsPerMonth": 12000,
     "pricePerCallUSD": null,
