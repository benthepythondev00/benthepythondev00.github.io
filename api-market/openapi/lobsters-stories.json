 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Lobsters Stories Scraper",
    "description": "Scrape Lobsters developer stories: titles, URLs, submitters, scores, tags, comments and timestamps. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "query": {
          "title": "Search query",
          "type": "string",
          "description": "Keyword, package, topic, entity, dataset, organization or model search term.",
          "default": "rust"
         },
         "maxResults": {
          "title": "Max results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum number of rows to return. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "query": "rust",
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "story_id": "plreds",
          "title": "Memory Safety Bugs in Rust Standard Library",
          "url": "https://forge-blog.github.io/posts/rust-std-memory-safety/",
          "comments_url": "https://lobste.rs/s/plreds/memory_safety_bugs_rust_standard_library",
          "created_at": "2026-11-10T13:44:50.546-06:00",
          "score": 6,
          "comment_count": 1,
          "submitter_user": "expurple",
          "tags": [
           "rust"
          ],
          "source": "Lobsters Stories",
          "search": "rust"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
