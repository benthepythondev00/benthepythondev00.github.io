 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Bitstamp Pairs Scraper",
    "description": "Collect Bitstamp pairs records and export name, description, trading, url symbol, base decimals, minimum order as structured JSON, CSV or Excel data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "name": "EUR/USD",
          "description": "Euro / U.S. dollar",
          "trading": "Enabled",
          "url_symbol": "eurusd",
          "base_decimals": 5,
          "minimum_order": "10.00000 USD",
          "counter_decimals": 5,
          "instant_and_market_orders": "Enabled",
          "instant_order_counter_decimals": 5,
          "source": "Bitstamp pairs",
          "scraped_at": "2026-10-07T17:35:23.848253+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
