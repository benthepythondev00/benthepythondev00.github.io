 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "DNS Records Checker",
    "description": "Look up public DNS records for domains and export A, AAAA, CNAME, MX, NS, TXT, SOA and CAA records as structured data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "targets": {
          "title": "Targets",
          "type": "array",
          "description": "Domains or URLs to check.",
          "default": [
           "apify.com"
          ],
          "items": {
           "type": "string"
          }
         },
         "maxResults": {
          "title": "Max results per target",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum rows to return per target. A request returns 20 rows at most.",
          "default": 20
         }
        }
       },
       "example": {
        "targets": [
         "apify.com"
        ],
        "maxResults": 10
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "domain": "apify.com",
          "record_type": "A",
          "value": "3.170.42.68",
          "source": "dns"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
