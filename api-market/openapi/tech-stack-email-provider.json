 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Tech Stack Detector",
    "description": "Detects the technologies behind any website: CMS, frameworks, analytics and hosting, one row per site. Up to 10 websites per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "urls"
        ],
        "properties": {
         "urls": {
          "title": "Website URLs",
          "type": "array",
          "description": "List of website URLs to analyze. Can include or omit https://",
          "default": [
           "https://stripe.com"
          ],
          "items": {
           "type": "string"
          }
         },
         "maxUrls": {
          "title": "Max URLs to Process",
          "minimum": 0,
          "maximum": 10,
          "type": "integer",
          "description": "Maximum number of URLs to analyze (0 = unlimited) A request returns 10 rows at most.",
          "default": 1
         },
         "includeDns": {
          "title": "Detect email and SaaS tools from DNS",
          "type": "boolean",
          "description": "Also read each domain's MX and TXT records (SPF and domain verification tokens) to find the email provider (Google Workspace, Microsoft 365, Zoho...), email senders (SendGrid, Mailgun, HubSpot...) and SaaS tools that verified the domain (Atlassian, Stripe, Facebook, Apple...). Adds about one DNS round trip per site, run in parallel with the page fetch.",
          "default": true
         }
        }
       },
       "example": {
        "urls": [
         "https://stripe.com",
         "https://vercel.com",
         "https://shopify.com"
        ],
        "maxUrls": 1
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "url": "https://stripe.com",
          "domain": "stripe.com",
          "success": true,
          "technologies": [
           {
            "name": "React",
            "category": "Frontend Framework",
            "confidence": "high",
            "version": null,
            "detectedBy": "html"
           },
           {
            "name": "Next.js",
            "category": "Frontend Framework",
            "confidence": "high",
            "version": null,
            "detectedBy": "html"
           },
           {
            "name": "Nginx",
            "category": "Web Server",
            "confidence": "high",
