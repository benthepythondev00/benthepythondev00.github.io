 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Bitfinex Tickers All Scraper",
    "description": "Collect Bitfinex tickers records and export value, value 2, value 3, value 4, value 5, value 6 as structured JSON, CSV or Excel data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "symbol": "tBTCUSD",
          "bid": 69797,
          "bid_size": 2.75569521,
          "ask": 69802,
          "ask_size": 3.32191838,
          "daily_change": -2778,
          "daily_change_relative": -0.03827501,
          "last_price": 69802,
          "source": "Bitfinex tickers",
          "scraped_at": "2026-11-13T13:45:50.996823+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
 "externalDocs": {
  "description": "API.market listing",
  "url": "https://api.market/store/benthepythondev/bitfinex-all-tickers"
 },
 "components": {
  "securitySchemes": {
   "apiMarketKey": {
    "type": "apiKey",
    "in": "header",
    "name": "x-api-market-key",
    "description": "Your API.market API key (https://api.market/account/apiKeys)."
   }
  }
 },
 "security": [
  {
   "apiMarketKey": []
  }
 ]
