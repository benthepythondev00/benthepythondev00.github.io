 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Instagram Comments Scraper",
    "description": "Returns the comments under Instagram posts and reels: comment text, author, time, likes, whether the author is verified and the post it belongs to. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "postUrls": {
          "title": "Post or reel links",
          "type": "array",
          "description": "Links such as https://www.instagram.com/p/DeAZ0uAgNuA/ or https://www.instagram.com/reel/DdG4RIxIPyf/. A bare shortcode works too.",
          "default": [
           "https://www.instagram.com/reel/DdG4RIxIPyf/"
          ],
          "items": {
           "type": "string"
          }
         },
         "maxResults": {
          "title": "Maximum comments per post",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Comments to save for each link. A request returns 20 rows at most.",
          "default": 20
         }
        }
       },
       "example": {
        "postUrls": [
         "https://www.instagram.com/reel/DdG4RIxIPyf/"
        ]
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        }
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
 "externalDocs": {
  "description": "API.market listing",
