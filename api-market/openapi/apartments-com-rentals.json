 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Apartments.com Rent & Availability Monitor",
    "description": "Apartments.com scraper for rent prices, availability and floor plans. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "locations": {
          "title": "Locations",
          "maxItems": 50,
          "type": "array",
          "description": "City and state (\"Austin, TX\"), 5-digit ZIP codes (\"78704\"), or full Apartments.com search URLs. Filters below apply to city and ZIP entries; a pasted URL keeps its own filters.",
          "items": {
           "type": "string"
          }
         },
         "minRent": {
          "title": "Minimum rent ($/month)",
          "minimum": 0,
          "maximum": 100000,
          "type": "integer",
          "description": "Only properties with a unit at or above this rent."
         },
         "maxRent": {
          "title": "Maximum rent ($/month)",
          "minimum": 0,
          "maximum": 20,
          "type": "integer",
          "description": "Only properties with a unit at or below this rent. A request returns 20 rows at most."
         },
         "minBeds": {
          "title": "Minimum bedrooms",
          "minimum": 0,
          "maximum": 5,
          "type": "integer",
          "description": "Only properties with units that have at least this many bedrooms. Leave empty for any, including studios."
         },
         "minBaths": {
          "title": "Minimum bathrooms",
          "minimum": 0,
          "maximum": 5,
          "type": "integer",
          "description": "Only properties with units that have at least this many bathrooms."
         },
         "pets": {
          "title": "Pets",
          "enum": [
           "none",
           "any",
           "dogs",
           "cats"
          ],
          "type": "string",
          "description": "Limit to pet-friendly properties.",
          "default": "none"
         },
         "propertyType": {
          "title": "Property type",
          "enum": [
           "any",
           "apartments",
           "houses",
           "condos",
           "townhomes"
          ],
          "type": "string",
          "description": "Apartments.com rental category.",
          "default": "any"
         },
         "maxResults": {
          "title": "Max properties",
          "minimum": 1,
          "maximum": 1000,
          "type": "integer",
          "description": "Maximum number of properties to scrape across all locations."
         },
         "includeFloorPlans": {
          "title": "Include floor plans",
          "type": "boolean",
          "description": "Add floorPlans[] with rent range, beds, baths, sqft and availability per plan.",
          "default": true
         },
         "includeUnits": {
          "title": "Include units",
          "type": "boolean",
          "description": "Add units[] with unit number, rent, sqft and available date for every listed unit.",
          "default": true
         },
         "stateKey": {
          "title": "State key",
          "type": "string",
          "description": "Name for this monitor's saved snapshot (for example \"austin-2br-under-2500\"). Use the same key every week. Left empty, a key is derived from the locations and filters."
         }
        }
       },
       "example": {
        "locations": [
         "Austin, TX"
        ],
        "maxResults": 20
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "listingId": "40n18nj",
          "name": "Edison Austin",
          "url": "https://www.apartments.com/edison-austin-austin-tx/40n18nj/",
          "propertyType": "Apartment Community",
          "address": "4711 E Riverside Dr",
          "city": "Austin",
          "state": "TX",
          "zip": "78741",
          "fullAddress": "4711 E Riverside Dr, Austin, TX 78741",
          "neighborhood": "East Riverside-Oltorf",
          "latitude": 30.231046,
          "longitude": -97.7187605,
          "rentMin": 1295,
          "rentMax": 2895,
          "bedsMin": 0,
          "bedsMax": 2,
          "bathsMin": 1,
          "bathsMax": 2,
          "sqftMin": 509,
          "sqftMax": 1429,
          "unitsAvailable": 13,
          "floorPlans": [
           {
            "name": "E2",
            "beds": 0,
            "baths": 1,
            "rentMin": 1295,
            "rentMax": 1295,
            "sqftMin": 509,
            "sqftMax": 509,
            "unitsAvailable": 1
           },
           {
