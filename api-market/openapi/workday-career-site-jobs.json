  }
 ],
 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Workday Jobs Scraper",
    "description": "Job postings from companies' Workday career sites such as Adobe, Intel, Disney and PayPal: title, company, location, posting date and link. Up to 20 jobs per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "companies": {
          "title": "Companies",
          "type": "array",
          "description": "Workday company configs with subdomain, career_site and name. Leave empty to use the built-in employer list."
         },
         "searchText": {
          "title": "Search Text",
          "type": "string",
          "description": "Search keywords (e.g., 'devops', 'engineer', 'software')."
         },
         "keywords": {
          "title": "Job Title Keywords",
          "type": "array",
          "description": "Filter jobs by title keywords. Leave empty for all jobs.",
          "items": {
           "type": "string"
          }
         },
         "remoteOnly": {
          "title": "Remote Only",
          "type": "boolean",
          "description": "Only return remote job positions.",
          "default": false
         },
         "maxResults": {
          "title": "Max Results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum number of jobs to return. A request returns 20 rows at most.",
          "default": 10
         },
         "includeDescriptions": {
          "title": "Include job descriptions",
          "type": "boolean",
          "description": "Fetch the full description, source posting date, employment type and additional locations for each matching job. Adds one request per job.",
          "default": false
         }
        }
       },
       "example": {
        "maxResults": 10
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "job_id": "R171924",
          "job_title": "Sr. Technical Account Manager",
          "company_name": "Adobe",
          "job_description": "",
          "location": "Mexico City",
          "remote_flag": false,
          "employment_type": "Unknown",
          "bullet_fields": [
           "R171924"
          ],
          "posted_date": "2026-10-06",
          "posted_date_text": "Posted Yesterday",
          "job_url": "https://adobe.wd5.myworkdayjobs.com/en-US/external_experienced/job/Mexico-City/Sr-Technical-Account-Manager_R171924",
          "source": "Workday",
          "scraped_at": "2026-10-07T07:43:57.498634"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
 "externalDocs": {
  "description": "API.market listing",
  "url": "https://api.market/store/benthepythondev/workday-career-site-jobs"
 },
 "components": {
  "securitySchemes": {
