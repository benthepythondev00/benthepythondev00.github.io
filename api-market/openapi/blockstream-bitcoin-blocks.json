 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Blockstream Blocks Scraper",
    "description": "Collect Blockstream blocks records and export id, bits, size, nonce, height, weight as structured JSON, CSV or Excel data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "id": "00000000000000000000dc716898e0fe716ca4c516a416b0ea3cb757d3cd0a7f",
          "bits": 386014960,
          "size": 1579534,
          "nonce": 799903884,
          "height": 970370,
          "weight": 3993628,
          "version": 537436160,
          "tx_count": 6970,
          "timestamp": 1791393157,
          "difficulty": 132716002350731.27,
          "mediantime": 1791391799,
          "merkle_root": "d6f376df3c141b621df1dd48c91e09c7892ac6df677c00f2d801e63940f1ff77",
          "previousblockhash": "00000000000000000000415537d1d8422cf9140319a91aed80d4060e3d083077",
          "source": "Blockstream blocks",
          "scraped_at": "2026-10-07T17:35:41.758522+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
