 "servers": [
  {
   "url": "https://prod.api.market/api/v1/benthepythondev/bank-of-canada-valet-series"
  }
 ],
 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Bank of Canada Series Scraper",
    "description": "Fetch recent Bank of Canada Valet observations with dates, values, series labels and source terms. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "seriesCode": {
          "title": "Series code",
          "type": "string",
          "description": "Valet series identifier.",
          "default": "FXUSDCAD"
         },
         "recent": {
          "title": "Recent observations",
          "minimum": 1,
          "maximum": 100,
          "type": "integer",
          "description": "Number of latest observations requested.",
          "default": 5
         },
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "seriesCode": "FXUSDCAD",
        "recent": 5,
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "date": "2026-11-12",
          "value": "1.4255",
          "series_code": "FXUSDCAD",
          "series_label": "USD/CAD",
          "series_description": "Daily average exchange rate of the US dollar in Canadian dollars.",
          "source": "Bank of Canada Valet",
          "scraped_at": "2026-11-13T00:33:51.347958+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
 "externalDocs": {
  "description": "API.market listing",
  "url": "https://api.market/store/benthepythondev/bank-of-canada-valet-series"
 },
 "components": {
  "securitySchemes": {
   "apiMarketKey": {
    "type": "apiKey",
    "in": "header",
    "name": "x-api-market-key",
    "description": "Your API.market API key (https://api.market/account/apiKeys)."
   }
  }
 },
 "security": [
  {
   "apiMarketKey": []
  }
 ]
