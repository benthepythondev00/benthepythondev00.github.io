 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "ArcGIS Hub Datasets Scraper",
    "description": "Search ArcGIS Hub datasets and export IDs, names, descriptions, owners, organizations, dates, tags, type, access, license and links. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "query": {
          "title": "Dataset query",
          "type": "string",
          "description": "ArcGIS Hub open-data search.",
          "default": "climate"
         },
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum normalized records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "query": "climate",
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "dataset_id": "c8fc0ea485144cb881b44db8786e2251",
          "name": "Climate.zip",
          "description": null,
          "owner": "EnvAtlasOman",
          "source_org": "EnvAtlasOman",
          "created_at": 1636111481000,
          "modified_at": 1636111484000,
          "tags": [
           "SQU"
          ],
          "item_type": "File Geodatabase",
          "access": "public",
          "license": "none",
          "dataset_url": "https://www.arcgis.com/home/item.html?id=c8fc0ea485144cb881b44db8786e2251",
          "source": "ArcGIS Hub",
          "scraped_at": "2026-10-07T17:33:08.004087+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
