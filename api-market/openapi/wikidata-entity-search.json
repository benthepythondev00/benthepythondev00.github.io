 "servers": [
  {
   "url": "https://prod.api.market/api/v1/benthepythondev/wikidata-entity-search"
  }
 ],
 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Wikidata Entities Scraper",
    "description": "Scrape Wikidata entity search results: QIDs, labels, descriptions, concept URLs and aliases for entity enrichment. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "query": {
          "title": "Search query",
          "type": "string",
          "description": "Keyword, package, topic, entity, dataset, organization or model search term.",
          "default": "Berlin"
         },
         "maxResults": {
          "title": "Max results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum number of rows to return. A request returns 20 rows at most.",
          "default": 10
         }
        }
       },
       "example": {
        "query": "Berlin",
        "maxResults": 10
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "entity_id": "Q64",
          "label": "Berlin",
          "description": "federated state, capital and largest city of Germany",
          "concept_url": "http://www.wikidata.org/entity/Q64",
          "url": "//www.wikidata.org/wiki/Q64",
          "aliases": null,
          "source": "Wikidata Entities",
          "search": "Berlin"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
 "externalDocs": {
  "description": "API.market listing",
  "url": "https://api.market/store/benthepythondev/wikidata-entity-search"
 },
 "components": {
  "securitySchemes": {
   "apiMarketKey": {
    "type": "apiKey",
    "in": "header",
    "name": "x-api-market-key",
    "description": "Your API.market API key (https://api.market/account/apiKeys)."
   }
  }
 },
 "security": [
  {
   "apiMarketKey": []
  }
 ]
}
