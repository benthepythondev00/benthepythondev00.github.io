 "paths": {
  "/": {
   "post": {
    "operationId": "run",
    "summary": "Open Targets Disease Scraper",
    "description": "Collect Open Targets Platform records and export id, name, description, entity, source, scraped at as structured JSON, CSV or Excel data. Up to 20 results per request, as JSON.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "query": {
          "title": "Disease query",
          "type": "string",
          "description": "Disease or phenotype keywords.",
          "default": "diabetes"
         },
         "maxResults": {
          "title": "Maximum results",
          "minimum": 1,
          "maximum": 20,
          "type": "integer",
          "description": "Maximum records saved to the default dataset. A request returns 20 rows at most.",
          "default": 3
         }
        }
       },
       "example": {
        "query": "diabetes",
        "maxResults": 3
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "The results, one object per row.",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object"
         }
        },
        "example": [
         {
          "id": "MONDO_0005015",
          "name": "diabetes mellitus",
          "description": "A metabolic disorder characterized by abnormally high blood sugar levels due to diminished production of insulin or insulin resistance/desensitization.",
          "entity": "disease",
          "source": "Open Targets Platform",
          "scraped_at": "2026-11-11T00:20:53.884209+00:00"
         }
        ]
       }
      }
     },
     "400": {
      "description": "The request body does not fit the input fields. The message says which field."
     }
    }
   }
  }
 },
