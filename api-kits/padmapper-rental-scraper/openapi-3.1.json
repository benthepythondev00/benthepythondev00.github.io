{
  "openapi": "3.1.0",
  "info": {
    "title": "PadMapper Rental Scraper API",
    "version": "1.0.0",
    "description": "Returns PadMapper rental listings in any US or Canadian city: rent range, beds and baths, address, neighbourhood, coordinates, property type, amenities, pet policy, availability date, contact phone and a lead score. Up to 20 results per request, as JSON.",
    "contact": {
      "name": "benthepythondev",
      "url": "https://rapidapi.com/benthepythondev0/api/padmapper-rental-scraper"
    },
    "termsOfService": "https://rapidapi.com/terms"
  },
  "servers": [
    {
      "url": "https://padmapper-rental-scraper.p.rapidapi.com",
      "description": "RapidAPI gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "RapidAPIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-rapidapi-key",
        "description": "Your RapidAPI application key."
      },
      "RapidAPIHost": {
        "type": "apiKey",
        "in": "header",
        "name": "x-rapidapi-host",
        "description": "Must be padmapper-rental-scraper.p.rapidapi.com."
      }
    }
  },
  "security": [
    {
      "RapidAPIKey": [],
      "RapidAPIHost": []
    }
  ],
  "paths": {
    "/": {
      "post": {
        "operationId": "padmapper_rental_scraper",
        "summary": "PadMapper Rental Scraper",
        "description": "Returns PadMapper rental listings in any US or Canadian city: rent range, beds and baths, address, neighbourhood, coordinates, property type, amenities, pet policy, availability date, contact phone and a lead score. Up to 20 results per request, as JSON.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locations": {
                    "title": "Locations",
                    "maxItems": 50,
                    "type": "array",
                    "description": "One or more PadMapper city slugs, city then state or province (e.g. 'san-francisco-ca', 'new-york-ny', 'toronto-on'). Each is searched on its own with the filters below, and Max listings applies per location.",
                    "items": {
                      "type": "string"
                    },
                    "default": [
                      "san-francisco-ca"
                    ]
                  },
                  "location": {
                    "title": "Location (single, older field)",
                    "type": "string",
                    "description": "One city slug, e.g. 'san-francisco-ca'. Kept so saved inputs keep working; it is searched together with Locations."
                  },
                  "propertyType": {
                    "title": "Property type",
                    "enum": [
                      "apartments",
                      "houses",
                      "condos",
                      "townhouses",
                      "rooms"
                    ],
                    "type": "string",
                    "description": "Type of rental to search for.",
                    "default": "apartments"
                  },
                  "minPrice": {
                    "title": "Min price ($/mo)",
                    "minimum": 0,
                    "maximum": 100000,
                    "type": "integer",
                    "description": "Minimum monthly rent in USD; cheaper listings are skipped. Example: 1500."
                  },
                  "maxPrice": {
                    "title": "Max price ($/mo)",
                    "minimum": 0,
                    "maximum": 100000,
                    "type": "integer",
                    "description": "Maximum monthly rent in USD; pricier listings are skipped. Example: 3500."
                  },
                  "minBeds": {
                    "title": "Min bedrooms",
                    "minimum": 0,
                    "maximum": 10,
                    "type": "integer",
                    "description": "Minimum number of bedrooms (0 = studio)."
                  },
                  "maxBeds": {
                    "title": "Max bedrooms",
                    "minimum": 0,
                    "maximum": 10,
                    "type": "integer",
                    "description": "Maximum number of bedrooms."
                  },
                  "maxListings": {
                    "title": "Max listings",
                    "minimum": 1,
                    "maximum": 20,
                    "type": "integer",
                    "description": "Maximum listings to return per location (with listing URLs: for the whole run). A request returns 20 rows at most.",
                    "default": 20
                  },
                  "maxPages": {
                    "title": "Result pages per search",
                    "minimum": 1,
                    "maximum": 1000,
                    "type": "integer",
                    "description": "PadMapper serves 10 listings per result page. The default reads 20 pages, about 200 listings per search. Raise it together with Max listings to export a whole city, for example 1,000 pages for up to 10,000 listings.",
                    "default": 20
                  },
                  "includePhotos": {
                    "title": "Include photos",
                    "type": "boolean",
                    "description": "Include listing image IDs and count.",
                    "default": true
                  },
                  "listingUrls": {
                    "title": "Listing/search URLs (advanced)",
                    "maxItems": 1000,
                    "type": "array",
                    "description": "Optional: specific PadMapper search URLs to scrape instead of building from location.",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "locations": [
                  "austin-tx"
                ],
                "maxListings": 2
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "JSON array of results (up to 20 items per request).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "source": "padmapper.com",
                    "scraped_at": "2026-11-26T23:15:51.367478+00:00",
                    "listing_id": 63223586,
                    "url": "https://www.padmapper.com/buildings/p1503505/seabrook-square-apartments-at-3515-manor-rd-austin-tx-78723",
                    "name": "Seabrook Square",
                    "address": "3515 Manor Rd, Austin, TX 78723",
                    "street": "3515 Manor Rd",
                    "city": "Austin",
                    "state": "TX",
                    "zipcode": "78723",
                    "neighborhood": "MLK",
                    "latitude": 30.288651,
                    "longitude": -97.698828,
                    "price_min": 1206,
                    "price_max": 1932,
                    "beds_min": 0,
                    "beds_max": 4,
                    "baths_min": 1,
                    "baths_max": 2,
                    "rating": null,
                    "property_type": "Apartment",
                    "amenities": [
                      "Outdoor Space",
                      "Onsite Laundry",
                      "EV Charging"
                    ],
                    "pets_allowed": [
                      "Dogs",
                      "Cats"
                    ],
                    "phone": "(737) 232-7079",
                    "brokerage_name": "AOG Living",
                    "date_available": "2026/11/25",
                    "has_fees": true,
                    "image_ids": [
                      905790314,
                      919993818
                    ],
                    "image_count": 10,
                    "lead_score": 34
                  }
                ]
              }
            }
          },
          "400": {
            "description": "The request body was refused, or the run found nothing for these filters; the message says which."
          },
          "401": {
            "description": "Missing or unknown x-rapidapi-key."
          },
          "403": {
            "description": "The key has no subscription to this API (subscribe to a plan, Basic is free)."
          },
          "429": {
            "description": "The plan's monthly quota or the gateway rate limit was reached."
          }
        }
      }
    }
  }
}
